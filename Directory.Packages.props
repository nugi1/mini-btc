<Project>
  <ItemGroup>
    <!-- DDD building blocks: https://github.com/nugi1/Patterns.DDD — versions move in lockstep. -->
    <PackageVersion Include="Patterns.DDD" Version="1.0.0" />
    <PackageVersion Include="Patterns.DDD.Application" Version="1.0.0" />
    <PackageVersion Include="Patterns.DDD.MassTransit" Version="1.0.0" />

    <!-- MassTransit v8: Apache 2.0, same line as Patterns.DDD.MassTransit (v9+ is commercially licensed). -->
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <!-- Integration tests start a real host (MassTransit hosted services). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />

    <!-- Infrastructure: typed HttpClient for Core's JSON-RPC, options from configuration. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />

    <!-- Persistence: EF Core 10 on PostgreSQL. Relational is pinned so every project resolves the
         same EF Core build (MassTransit alone would bring an older one). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />

    <!-- RIPEMD-160 for Hash160: not in the .NET BCL on .NET Core/5+. MIT licence. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
