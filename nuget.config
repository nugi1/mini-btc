<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org only, whatever feeds this machine has configured globally.
  Keeps restores reproducible (fresh clones, CI) and satisfies NU1507, which central
  package management raises when several sources exist without source mapping.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
