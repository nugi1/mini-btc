# Copy to .env and change if you like. Docker Compose reads .env automatically.
# Local development only: these services are bound to 127.0.0.1.

BTC_RPC_USER=minibtc
BTC_RPC_PASSWORD=minibtc-regtest

POSTGRES_USER=minibtc
POSTGRES_PASSWORD=minibtc
POSTGRES_DB=minibtc
# 5433 on the host so a locally installed PostgreSQL on 5432 doesn't clash.
POSTGRES_HOST_PORT=5433

RABBITMQ_USER=minibtc
RABBITMQ_PASSWORD=minibtc
